---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import Icon from '../components/Icon.astro'
import { personal, education, getExperience, getToolbox } from '../lib/data'
import { formatRange } from '../lib/format'
import { url } from '../lib/url'

const jobs = await getExperience()
const toolbox = await getToolbox()
---
<Base title={`Résumé · ${personal.name}`} description={`Printable résumé for ${personal.name}, generated from the same data as the portfolio.`} path="resume/" noindex>
  <Nav home={false} />
  <main id="main" class="container page">
    <div class="flex-between">
      <div><span class="eyebrow">Print view</span><h1>{personal.name}</h1></div>
      <div class="cta-row"><button class="btn btn--primary" type="button" data-print><Icon name="download" /> Print / save as PDF</button><a class="btn" href={url(personal.resumeFile)} target="_blank" rel="noopener">Official PDF</a></div>
    </div>
    <p class="lead mt-4">{personal.status}</p>
    <p class="mt-3 mono small">{personal.email} · <a href={personal.linkedin}>{personal.linkedin.replace('https://www.', '')}</a> · <a href={personal.github}>{personal.github.replace('https://', '')}</a></p>

    <section class="page-sec"><h2>Summary</h2><p>{personal.summary}</p></section>
    <section class="page-sec"><h2>Education</h2>
      <p><b>{education.school}</b>, {education.location}. {education.degree} ({education.minor}). {education.honor}, GPA {education.gpa}. {education.graduated}.</p>
      <p class="small">{education.honors.join(' · ')}</p>
    </section>
    <section class="page-sec"><h2>Experience</h2>
      {jobs.map(({ data: j }) => (
        <div class="resume-job">
          <p class="resume-job__top"><b>{j.role}</b>, {j.company}<span class="mono dim"> · {formatRange(j.start, j.end)}</span></p>
          <ul class="list-tight">{j.bullets.map((b) => <li>{b}</li>)}</ul>
        </div>
      ))}
    </section>
    <section class="page-sec"><h2>Skills</h2>
      {toolbox.map(({ data: g }) => <p><b>{g.label}:</b> {g.items.map((i) => i.name).join(', ')}</p>)}
    </section>
  </main>
  <Footer />
  <script>
    import '../scripts/site.ts'
  </script>
</Base>
